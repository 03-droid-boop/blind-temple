        /**
         * 綁定結束畫面的「鎖定期間點擊無效嘟聲」與「長按 1 秒進度條確認」
         */
        function setupResultHoldButtons() {
            const resultScreen = document.getElementById('result-screen');

            // 在 3 秒鎖定期間，點擊結束畫面任何處都會發出輕微「嘟」的無效提示音
            resultScreen.addEventListener('touchstart', (e) => {
                if (gameState.isResultLocked) {
                    audio.playBlockedBeep();
                    triggerHaptic(25);
                }
            }, { passive: true });

            resultScreen.addEventListener('mousedown', (e) => {
                if (gameState.isResultLocked) {
                    audio.playBlockedBeep();
                }
            });

            // 輔助函數：為指定按鈕綁定長按 1 秒（1000ms）進度條與漸進震動回饋
            function bindHoldAction(btnEl, barEl, labelEl, onComplete) {
                const HOLD_DURATION = 1000; // 1 秒
                let holdStart = 0;
                let lastVibeTick = 0;
                let defaultText = "";

                const startHold = (e) => {
                    if (gameState.isResultLocked || btnEl.disabled) {
                        audio.playBlockedBeep();
                        return;
                    }
                    if (e.type === 'touchstart') e.preventDefault();

                    if (holdInterval) clearInterval(holdInterval);
                    holdStart = performance.now();
                    lastVibeTick = 0;
                    defaultText = labelEl.textContent;

                    triggerHaptic(35);
                    audio.playUnlockChime(0.85);

                    holdInterval = setInterval(() => {
                        const elapsed = performance.now() - holdStart;
                        const pct = Math.min(100, (elapsed / HOLD_DURATION) * 100);
                        barEl.style.width = `${pct}%`;

                        // 每 250ms 給予漸進短震動回饋
                        const tick = Math.floor(elapsed / 250);
                        if (tick > lastVibeTick && pct < 100) {
                            lastVibeTick = tick;
                            triggerHaptic(25 + tick * 15);
                        }

                        if (pct >= 100) {
                            clearInterval(holdInterval);
                            holdInterval = null;
                            barEl.style.width = '100%';
                            triggerHaptic([80, 40, 120]);
                            audio.playUnlockChime(1.35);
                            onComplete();
                        }
                    }, 30);
                };

                const cancelHold = () => {
                    if (holdInterval) {
                        clearInterval(holdInterval);
                        holdInterval = null;
                        barEl.style.width = '0%';
                        if (defaultText && !btnEl.disabled) {
                            labelEl.textContent = defaultText;
                        }
                    }
                };

                btnEl.addEventListener('touchstart', startHold, { passive: false });
                btnEl.addEventListener('touchend', cancelHold);
                btnEl.addEventListener('touchcancel', cancelHold);

                btnEl.addEventListener('mousedown', startHold);
                btnEl.addEventListener('mouseup', cancelHold);
                btnEl.addEventListener('mouseleave', cancelHold);

                // 支援螢幕報讀器（VoiceOver / TalkBack）或鍵盤 Enter/Space 無障礙直接觸發
                btnEl.addEventListener('keydown', (e) => {
                    if ((e.key === 'Enter' || e.key === ' ') && !gameState.isResultLocked && !btnEl.disabled) {
                        e.preventDefault();
                        onComplete();
                    }
                });
            }

            bindHoldAction(
                document.getElementById('btn-hold-primary'),
                document.getElementById('hold-primary-bar'),
                document.getElementById('btn-hold-primary-label'),
                () => {
                    if (gameState.lastWinState) {
                        handleNextLevel();
                    } else {
                        startLevel(gameState.level);
                    }
                }
            );

            bindHoldAction(
                document.getElementById('btn-hold-secondary'),
                document.getElementById('hold-secondary-bar'),
                document.getElementById('btn-hold-secondary-label'),
                () => {
                    startLevel(gameState.level);
                }
            );
        }

        function triggerShake() {
            const el = document.getElementById('game-screen');
            el.classList.remove('shake-active');
            void el.offsetWidth;
            el.classList.add('shake-active');
