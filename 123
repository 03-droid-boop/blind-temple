        /**
         * ============================================================================
         * 7. 視覺模式切換（全黑盲人模式 vs 重度弱視極度模糊光影模式）
         * ============================================================================
         */
        function toggleVisionMode() {
            const btn = document.getElementById('btn-vision-toggle');
            const aiZone = document.getElementById('zone-ai-dog');
            const stepZone = document.getElementById('zone-step-forward');

            if (gameState.visionMode === 'blind') {
