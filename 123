<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>盲人過馬路 - 手機版聽聲辨車流 AI 導盲遊戲</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@700;900&display=swap');

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            width: 100%;
            height: 100dvh;
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Noto Sans TC', sans-serif;
            background-color: #000000;
            color: #FFFFFF;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none; /* 防止手機瀏覽器預設下拉重整與滑動捲動 */
        }

        /* 無障礙高對比焦點框 */
        button:focus-visible, [role="button"]:focus-visible {
            outline: 4px solid #FFD600;
            outline-offset: -4px;
        }

        /* 巨型按鈕按壓回饋 */
        .giant-zone {
            transition: transform 0.08s ease, filter 0.12s ease;
        }
        .giant-zone:active {
            transform: scale(0.985);
            filter: brightness(1.12);
        }

        /* 聲波脈衝動畫 */
        @keyframes sonar-pulse {
            0% { transform: scale(0.85); opacity: 0.9; }
            100% { transform: scale(2.1); opacity: 0; }
        }
        .sonar-ring {
            animation: sonar-pulse 1.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
        }

        /* 畫面強烈震動（驚險擦身或撞擊） */
        @keyframes screen-shake {
            0%, 100% { transform: translate(0, 0); }
            20% { transform: translate(-10px, 4px); }
            40% { transform: translate(10px, -4px); }
            60% { transform: translate(-8px, -3px); }
            80% { transform: translate(8px, 3px); }
        }
        .shake-active {
            animation: screen-shake 0.35s ease-in-out;
        }

        /* 長按按鈕內部填充進度條平滑過渡 */
        .hold-progress-fill {
            transition: width 0.05s linear;
        }
    </style>
</head>
<body class="flex flex-col justify-between bg-black text-white">

    <!-- 螢幕報讀器即時語音播報區 (ARIA Live Region) -->
    <div id="sr-announcer" class="sr-only" aria-live="assertive" aria-atomic="true"></div>

    <!-- =========================================================================
         1. 初始啟動畫面（點擊螢幕任意處啟動手機 Web Audio API 與語音）
         ========================================================================= -->
    <section id="start-screen" role="button" tabindex="0" aria-label="盲人過馬路遊戲啟動畫面。請戴上雙耳耳機，點擊螢幕任意處啟動音效並開始遊戲。"
        onclick="initAndStartGame()" onkeydown="if(event.key==='Enter'||event.key===' ') initAndStartGame()"
        class="fixed inset-0 z-50 flex flex-col justify-between p-6 bg-black text-white cursor-pointer">
        
        <div class="pt-4 text-center">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-400/20 border-2 border-yellow-400 text-yellow-300 text-sm font-black mb-4">
                <span>🎧 強烈建議戴上雙耳耳機</span>
            </div>
            <h1 class="text-4xl sm:text-5xl font-black tracking-wider text-yellow-400 mb-3">盲人過馬路</h1>
            <p class="text-lg sm:text-xl font-bold text-zinc-200">聽聲辨車流 · AI 導盲犬語音輔助</p>
        </div>

        <div class="my-auto bg-zinc-950 border-2 border-zinc-800 rounded-3xl p-5 space-y-3 text-base sm:text-lg">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-blue-900 border border-blue-400 flex items-center justify-center text-xl shrink-0">🐕‍🦺</span>
                <p class="font-bold text-blue-200"><strong class="text-white">點擊上半部：</strong>呼叫 AI 導盲犬分析左右車流空檔</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-yellow-400 text-black flex items-center justify-center text-xl font-black shrink-0">⬆️</span>
                <p class="font-bold text-yellow-200"><strong class="text-yellow-400">點擊下半部 / 上滑：</strong>踏出一步過馬路（下滑可後退）</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-zinc-800 border border-zinc-600 flex items-center justify-center text-xl shrink-0">📳</span>
                <p class="font-bold text-zinc-300"><strong class="text-white">3D 空間音訊 + 震動：</strong>聽引擎都卜勒效應與布穀鳥號誌</p>
            </div>
        </div>

        <div class="pb-4">
            <div class="w-full py-6 px-4 rounded-3xl bg-yellow-400 text-black text-center font-black text-2xl sm:text-3xl shadow-2xl shadow-yellow-400/30 animate-pulse">
                點擊螢幕任意處開始
            </div>
        </div>
    </section>

    <!-- =========================================================================
         2. 遊戲主畫面（手機直立無捲動滿版設計：頂部狀態列 + 上40%導盲犬 + 下60%前進）
         ========================================================================= -->
    <div id="game-screen" class="hidden flex-col w-full h-full relative">
        
        <!-- 視覺模擬底層畫布（全盲全黑 / 重度弱視模糊光暈） -->
        <canvas id="vision-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>

        <!-- 頂部極簡高對比狀態與視覺模式切換列 -->
        <header class="relative z-20 flex items-center justify-between px-3 py-2.5 bg-zinc-950/95 border-b-2 border-zinc-800 shrink-0">
            <div class="flex flex-col">
                <span id="hud-level" class="text-xs font-black text-yellow-400">第 1 關：社區雙線道</span>
                <div class="flex items-center gap-2 text-base font-black">
                    <span id="hud-lane" class="text-white">起點人行道</span>
                    <span class="text-zinc-600">|</span>
                    <span class="text-emerald-400"><span id="hud-timer">45</span>秒</span>
                </div>
            </div>

            <button id="btn-vision-toggle" onclick="toggleVisionMode()" aria-label="切換視覺模擬模式，目前為全黑盲人模式"
                class="px-3.5 py-2.5 rounded-2xl bg-zinc-900 border-2 border-yellow-400 text-yellow-300 font-black text-xs sm:text-sm active:scale-95">
                👁️ 全盲黑屏模式
            </button>
        </header>

        <!-- 上半部觸控區（佔剩餘高度 40%）：呼叫 AI 導盲犬 / 聽取路況建議 -->
        <section id="zone-ai-dog" role="button" tabindex="0" 
            aria-label="上半部按鈕：呼叫 AI 導盲犬，聽取目前左右車道車流空檔與安全建議"
            class="giant-zone relative z-10 h-[40%] w-full flex flex-col items-center justify-center p-4 bg-blue-950/85 border-b-4 border-yellow-400 text-center cursor-pointer">
            
            <div class="flex items-center gap-2.5 mb-2">
                <div class="relative flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-600 border-2 border-white text-2xl shadow-lg">
                    <span class="absolute inset-0 rounded-2xl border-2 border-blue-300 sonar-ring"></span>
                    🐕‍🦺
                </div>
                <div class="text-left">
                    <h2 class="text-xl sm:text-2xl font-black text-white tracking-wide">呼叫 AI 導盲犬</h2>
                    <p class="text-xs sm:text-sm font-bold text-blue-200">點擊或長按：即時分析車流空檔</p>
                </div>
            </div>

            <!-- 即時語音字幕與 AI 回應顯示框 -->
            <div class="w-full max-w-md bg-black/80 border-2 border-blue-400/60 rounded-2xl px-4 py-2.5 mt-1">
                <p id="ai-live-text" class="text-sm sm:text-base font-black text-blue-100 leading-snug line-clamp-3">
                    「汪！我是你的 AI 導盲犬，戴好耳機，隨時點我幫你看路況！」
                </p>
            </div>
        </section>

        <!-- 下半部巨型觸控區（佔剩餘高度 60%）：前進 / 跨出一步（支援點擊與上下滑動手勢） -->
        <section id="zone-step-forward" role="button" tabindex="0"
            aria-label="下半部巨型按鈕：向前跨出一步過馬路。也可以向上滑動前進，或向下滑動後退一步。"
            class="giant-zone relative z-10 h-[60%] w-full flex flex-col items-center justify-center p-5 bg-yellow-400/95 text-black text-center cursor-pointer">
            
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-black text-yellow-400 flex items-center justify-center text-4xl sm:text-5xl font-black mb-3 shadow-xl">
                ⬆️
            </div>
            <h2 class="text-3xl sm:text-4xl font-black tracking-wider mb-2">前進 · 跨出一步</h2>
            <p id="step-hint-text" class="text-base sm:text-lg font-black text-zinc-900 bg-yellow-300/90 px-4 py-1.5 rounded-xl border border-black/20">
                點擊或向上滑動前進 ｜ 向下滑動後退
            </p>
        </section>
    </div>

    <!-- =========================================================================
         3. 過關 / 碰撞結算全螢幕無障礙報告彈窗（含 3 秒防誤觸冷卻 + 長按 1 秒確認）
         ========================================================================= -->
    <section id="result-screen" role="dialog" aria-modal="true" aria-labelledby="res-title"
        class="hidden fixed inset-0 z-50 flex flex-col justify-between p-5 bg-black text-white border-8 border-zinc-800 transition-colors duration-300">
        
        <!-- 頂部結束大字橫幅與防誤觸鎖定狀態列 -->
        <div class="text-center pt-1">
            <div id="res-lock-banner" class="w-full py-2 px-3 rounded-2xl bg-zinc-900 border-2 border-zinc-600 text-amber-300 font-black text-sm sm:text-base mb-2 flex items-center justify-center gap-2">
                <span>🔒 防誤觸保護鎖定中 (3)</span>
            </div>
            <div id="res-badge" class="inline-block px-5 py-1 rounded-full text-base font-black mb-1 bg-emerald-500 text-black">
                遊戲結束 · 挑戰成功
            </div>
            <h2 id="res-title" class="text-4xl sm:text-5xl font-black text-yellow-400 tracking-wide mb-1">安全抵達對面！</h2>
            <p id="res-subtitle" class="text-base sm:text-lg font-bold text-zinc-200">成功穿越馬路</p>
        </div>

        <!-- 超大高對比生存戰績卡片（4格：時間、總步數、驚險閃避、累積過關） -->
        <div class="grid grid-cols-2 gap-2.5 my-2">
            <div class="bg-black/80 border-2 border-zinc-700 rounded-2xl p-2.5 text-center">
                <div class="text-xs font-bold text-zinc-400">本局耗時</div>
                <div id="stat-time" class="text-2xl font-black text-white mt-0.5">0.0s</div>
            </div>
            <div class="bg-black/80 border-2 border-zinc-700 rounded-2xl p-2.5 text-center">
                <div class="text-xs font-bold text-zinc-400">累計移動步數</div>
                <div id="stat-steps" class="text-2xl font-black text-sky-400 mt-0.5">0 步</div>
            </div>
            <div class="bg-black/80 border-2 border-zinc-700 rounded-2xl p-2.5 text-center">
                <div class="text-xs font-bold text-zinc-400">驚險閃避</div>
                <div id="stat-nearmiss" class="text-2xl font-black text-amber-400 mt-0.5">0 次</div>
            </div>
            <div class="bg-black/80 border-2 border-zinc-700 rounded-2xl p-2.5 text-center">
                <div class="text-xs font-bold text-zinc-400">累積過關</div>
                <div id="stat-wins" class="text-2xl font-black text-emerald-400 mt-0.5">0 次</div>
            </div>
        </div>

        <!-- AI 導盲犬賽後講評 -->
        <div class="bg-black/85 border-2 border-blue-400/80 rounded-3xl p-3.5 my-auto space-y-2">
            <div class="flex items-center gap-2 text-blue-300 font-black text-sm">
                <span>🐕‍🦺 AI 導盲犬復盤與暖心祝福</span>
            </div>
            <p id="res-ai-comment" class="text-sm sm:text-base font-bold text-white leading-relaxed">
                正在整理聽覺反應紀錄...
            </p>
            <div id="res-warm-quote" class="pt-2 border-t border-blue-400/30 text-xs sm:text-sm font-bold text-amber-200 leading-relaxed">
                💛 願每一次出發都被溫柔守護，我們始終與你同行。
            </div>
        </div>

        <!-- 底部防誤觸鎖定 / 長按 1 秒確認操作區 -->
        <div class="flex flex-col gap-2.5 pb-1">
            <!-- 主操作按鈕：前 3 秒鎖定，解鎖後需長按 1 秒（或無障礙雙擊啟動） -->
            <button id="btn-hold-primary" type="button" disabled
                aria-label="防誤觸保護鎖定中，請稍候三秒"
                class="relative overflow-hidden w-full py-5 px-4 rounded-3xl bg-zinc-800 border-4 border-zinc-600 text-zinc-400 font-black text-xl sm:text-2xl shadow-xl select-none">
                <!-- 長按進度條背景 -->
                <div id="hold-primary-bar" class="hold-progress-fill absolute inset-y-0 left-0 w-0 bg-emerald-400/40 pointer-events-none"></div>
                <span id="btn-hold-primary-label" class="relative z-10">🔒 防誤觸保護中 (3秒)...</span>
            </button>

            <!-- 次要操作按鈕（過關時提供長按重玩本關，事故時隱藏） -->
            <button id="btn-hold-secondary" type="button" disabled
                aria-label="防誤觸保護鎖定中"
                class="hidden relative overflow-hidden w-full py-3.5 px-4 rounded-2xl bg-zinc-900 border-2 border-zinc-700 text-zinc-500 font-black text-base sm:text-lg select-none">
                <div id="hold-secondary-bar" class="hold-progress-fill absolute inset-y-0 left-0 w-0 bg-yellow-400/35 pointer-events-none"></div>
                <span id="btn-hold-secondary-label" class="relative z-10">🔒 鎖定中...</span>
            </button>
        </div>
    </section>

    <script>
        /**
         * ============================================================================
         * 1. 關卡與車種聲學參數設定
         * ============================================================================
         */
        const LEVELS = {
            1: {
                id: 1,
                name: "第 1 關：社區雙線道",
                lanes: 2,
                timeLimit: 45,
                spawnMin: 2.5,
                spawnMax: 4.0,
                laneConfigs: [
                    { dir: 1, speed: 0.36, types: ['car'] },              // 第1車道：左往右一般轎車
                    { dir: -1, speed: 0.40, types: ['car', 'scooter'] }   // 第2車道：右往左轎車與機車
                ],
                intro: "第一關，社區雙線道。前方共有兩條車道。聽見布穀鳥綠燈聲後，仔細辨別左右引擎聲，抓準空檔點擊下半部螢幕前進。"
            },
            2: {
                id: 2,
                name: "第 2 關：市區三線道",
                lanes: 3,
                timeLimit: 55,
                spawnMin: 1.9,
                spawnMax: 3.3,
                laneConfigs: [
                    { dir: 1, speed: 0.42, types: ['scooter', 'car'] },   // 第1車道：左往右機車與轎車
                    { dir: -1, speed: 0.50, types: ['car', 'bus'] },      // 第2車道：右往左轎車與大型公車
                    { dir: 1, speed: 0.56, types: ['scooter', 'car'] }    // 第3車道：左往右快速車流
                ],
                intro: "第二關，市區三線道。車道變寬且有低頻沉重的大型公車與高頻疾駛機車，隨時可點上半部呼叫我幫你分析空檔！"
            },
            3: {
                id: 3,
                name: "第 3 關：繁華十字路口四線道",
                lanes: 4,
                timeLimit: 65,
                spawnMin: 1.6,
                spawnMax: 2.9,
                laneConfigs: [
                    { dir: 1, speed: 0.45, types: ['scooter', 'car'] },
                    { dir: 1, speed: 0.62, types: ['car', 'ambulance'] }, // 含高速鳴笛救護車
                    { dir: -1, speed: 0.54, types: ['bus', 'car'] },
                    { dir: -1, speed: 0.48, types: ['scooter', 'car'] }
                ],
                intro: "第三關，繁華十字路口四線道！注意遠方高速鳴笛的緊急救護車，千萬不要搶快，穩健聽聲通過！"
            }
        };

        const VEHICLES = {
            car:       { name: "一般轎車", baseFreq: 88,  harmFreq: 176, width: 0.16, color: "#FFD600" },
            scooter:   { name: "疾駛機車", baseFreq: 175, harmFreq: 350, width: 0.11, color: "#00E5FF" },
            bus:       { name: "大型公車", baseFreq: 52,  harmFreq: 104, width: 0.25, color: "#FF6D00" },
            ambulance: { name: "鳴笛救護車", baseFreq: 110, harmFreq: 680, width: 0.20, color: "#FF1744", isEmergency: true }
        };

        const gameState = {
            isRunning: false,
            level: 1,
            visionMode: 'blind', // 'blind' (全黑盲人模式) | 'lowvision' (重度弱視模糊光影)
            playerLane: 0,       // 0 = 起點人行道, 1..lanes = 車道, lanes + 1 = 終點人行道
            totalLanes: 2,
            vehicles: [],
            timeLeft: 45,
            elapsedTime: 0,
            stepCount: 0,
            nearMissCount: 0,
            totalWins: 0,
            aiQueryCount: 0,
            laneTimers: [],
            // 結束畫面防誤觸保護狀態
            isResultLocked: false,
            lockCountdown: 0,
            lastWinState: false
        };

        let rafId = null;
        let lastTime = 0;
        let signalBeepTimer = 0;
        let isRequestingAI = false;
        let resultLockTimer = null;
        let holdInterval = null;

        /**
         * ============================================================================
         * 2. 觸覺震動與中文語音合成 (TTS + ARIA Live Region)
         * ============================================================================
         */
        function triggerHaptic(pattern) {
            if ('vibrate' in navigator) {
                try {
                    navigator.vibrate(pattern);
                } catch (e) {}
            }
        }

        function speakText(text, interrupt = true, rate = 1.15) {
            // 同步更新 ARIA Live Region 供 VoiceOver / TalkBack 朗讀
            const sr = document.getElementById('sr-announcer');
            if (sr) {
                sr.textContent = '';
                setTimeout(() => { sr.textContent = text; }, 20);
            }

            // 更新畫面上的 AI 導盲犬字幕框
            const aiTextEl = document.getElementById('ai-live-text');
            if (aiTextEl) {
                aiTextEl.textContent = `「${text}」`;
            }

            if (!('speechSynthesis' in window)) return;
            if (interrupt) {
                window.speechSynthesis.cancel();
            }

            const utter = new SpeechSynthesisUtterance(text);
            utter.lang = 'zh-TW';
            utter.rate = rate;
            utter.pitch = 1.05;

            const voices = window.speechSynthesis.getVoices();
            const twVoice = voices.find(v => v.lang.includes('zh-TW')) || voices.find(v => v.lang.includes('zh'));
            if (twVoice) utter.voice = twVoice;

            window.speechSynthesis.speak(utter);
        }

        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
        }

        /**
         * ============================================================================
         * 3. 3D 雙耳空間音訊引擎 (純 Web Audio API 物理聲學模擬)
         * ============================================================================
         */
        class SpatialAudioEngine {
            constructor() {
                this.ctx = null;
                this.masterGain = null;
                this.nodes = new Map();
            }

            unlock() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                    this.masterGain = this.ctx.createGain();
                    this.masterGain.gain.value = 0.9;
                    this.masterGain.connect(this.ctx.destination);
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            createVehicleSound(v) {
                if (!this.ctx) return;
                const spec = VEHICLES[v.type];

                const oscMain = this.ctx.createOscillator();
                oscMain.type = v.type === 'scooter' ? 'sawtooth' : 'triangle';
                oscMain.frequency.value = spec.baseFreq;

                const oscHarm = this.ctx.createOscillator();
                oscHarm.type = spec.isEmergency ? 'sine' : 'sawtooth';
                oscHarm.frequency.value = spec.harmFreq;

                const harmGain = this.ctx.createGain();
                harmGain.gain.value = spec.isEmergency ? 0.55 : 0.35;

                // 低通濾波模擬空氣距離高頻衰減
                const filter = this.ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.value = 220;

                // StereoPannerNode 左右聲道定位 (-1 左耳 到 +1 右耳)
                const panner = this.ctx.createStereoPanner();
                panner.pan.value = Math.max(-1, Math.min(1, v.x));

                const gain = this.ctx.createGain();
                gain.gain.value = 0.001;

                oscMain.connect(filter);
                oscHarm.connect(harmGain);
                harmGain.connect(filter);
                filter.connect(panner);
                panner.connect(gain);
                gain.connect(this.masterGain);

                oscMain.start();
                oscHarm.start();

                this.nodes.set(v.id, { oscMain, oscHarm, filter, panner, gain, spec, sirenPhase: 0 });
            }

            updateVehicleSound(v, playerLane, dt) {
                const node = this.nodes.get(v.id);
                if (!node || !this.ctx) return;

                const now = this.ctx.currentTime;
                // 精準左右聲道平移
                const pan = Math.max(-1, Math.min(1, v.x));
                node.panner.pan.setTargetAtTime(pan, now, 0.04);

                // 計算玩家與車輛的 2D 空間距離
                const dx = Math.abs(v.x);
                const dy = Math.abs(v.lane - playerLane) * 0.42;
                const dist = Math.sqrt(dx * dx + dy * dy);

                // 距離越近音量越大、高頻越清晰
                const proximity = Math.max(0, 1 - dist / 1.55);
                const vol = Math.pow(proximity, 1.65) * (v.type === 'bus' ? 0.6 : 0.45);
                node.gain.gain.setTargetAtTime(vol, now, 0.05);

                const cutoff = 180 + Math.pow(proximity, 1.4) * 1600;
                node.filter.frequency.setTargetAtTime(cutoff, now, 0.05);

                // 都卜勒效應：靠近時音高上升，遠離時音高下降
                const approaching = (v.dir === 1 && v.x < 0) || (v.dir === -1 && v.x > 0);
                const doppler = approaching ? (1 + 0.15 * proximity) : (1 - 0.13 * proximity);
                node.oscMain.frequency.setTargetAtTime(node.spec.baseFreq * doppler, now, 0.05);

                if (node.spec.isEmergency) {
                    // 救護車雙音高頻警笛交替
                    node.sirenPhase += dt * 4.5;
                    const sirenFreq = Math.sin(node.sirenPhase) > 0 ? 780 : 620;
                    node.oscHarm.frequency.setTargetAtTime(sirenFreq * doppler, now, 0.04);
                } else {
                    node.oscHarm.frequency.setTargetAtTime(node.spec.harmFreq * doppler, now, 0.05);
                }
            }

            removeVehicleSound(id) {
                const node = this.nodes.get(id);
                if (node) {
                    try {
                        node.oscMain.stop();
                        node.oscHarm.stop();
                        node.gain.disconnect();
                    } catch (e) {}
                    this.nodes.delete(id);
                }
            }

            clearAll() {
                for (const id of this.nodes.keys()) {
                    this.removeVehicleSound(id);
                }
            }

            // 腳步聲與導盲杖敲擊導盲磚清脆聲響
            playStepAndCane(isForward) {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;

                // 腳步低頻悶響
                const stepOsc = this.ctx.createOscillator();
                const stepGain = this.ctx.createGain();
                stepOsc.type = 'sine';
                stepOsc.frequency.setValueAtTime(isForward ? 115 : 85, now);
                stepOsc.frequency.exponentialRampToValueAtTime(38, now + 0.11);
                stepGain.gain.setValueAtTime(0.45, now);
                stepGain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
                stepOsc.connect(stepGain);
                stepGain.connect(this.masterGain);
                stepOsc.start(now);
                stepOsc.stop(now + 0.13);

                // 導盲杖敲擊導盲磚雙擊清脆聲
                [0.06, 0.14].forEach((delay, idx) => {
                    const caneOsc = this.ctx.createOscillator();
                    const caneGain = this.ctx.createGain();
                    caneOsc.type = 'triangle';
                    caneOsc.frequency.setValueAtTime(idx === 0 ? 2100 : 1850, now + delay);
                    caneOsc.frequency.exponentialRampToValueAtTime(650, now + delay + 0.05);
                    caneGain.gain.setValueAtTime(0.28, now + delay);
                    caneGain.gain.exponentialRampToValueAtTime(0.001, now + delay + 0.055);
                    caneOsc.connect(caneGain);
                    caneGain.connect(this.masterGain);
                    caneOsc.start(now + delay);
                    caneOsc.stop(now + delay + 0.06);
                });
            }

            // 台灣行人號誌有聲提示（布穀鳥雙音節 / 緊急倒數急促蜂鳴）
            playCrosswalkSignal(isUrgent) {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';

                if (!isUrgent) {
                    // 布穀鳥「布-穀」雙音
                    osc.frequency.setValueAtTime(880, now);
                    osc.frequency.setValueAtTime(698, now + 0.09);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                    osc.connect(gain);
                    gain.connect(this.masterGain);
                    osc.start(now);
                    osc.stop(now + 0.23);
                } else {
                    // 最後 10 秒急促高頻蜂鳴
                    osc.frequency.setValueAtTime(1046, now);
                    gain.gain.setValueAtTime(0.11, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
                    osc.connect(gain);
                    gain.connect(this.masterGain);
                    osc.start(now);
                    osc.stop(now + 0.13);
                }
            }

            // 車輛緊急喇叭聲（驚險擦身）
            playEmergencyHorn(panVal) {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const panner = this.ctx.createStereoPanner();
                panner.pan.value = Math.max(-1, Math.min(1, panVal));

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.42, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.38);

                [440, 554.37].forEach(freq => {
                    const osc = this.ctx.createOscillator();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(freq, now);
                    osc.connect(panner);
                    osc.start(now);
                    osc.stop(now + 0.4);
                });

                panner.connect(gain);
                gain.connect(this.masterGain);
            }

            // 碰撞事故低頻衝擊與急煞聲
            playCrash() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;

                // 急煞高頻摩擦聲
                const screechOsc = this.ctx.createOscillator();
                const screechGain = this.ctx.createGain();
                screechOsc.type = 'sawtooth';
                screechOsc.frequency.setValueAtTime(1400, now);
                screechOsc.frequency.exponentialRampToValueAtTime(320, now + 0.28);
                screechGain.gain.setValueAtTime(0.32, now);
                screechGain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
                screechOsc.connect(screechGain);
                screechGain.connect(this.masterGain);
                screechOsc.start(now);
                screechOsc.stop(now + 0.31);

                // 低頻沉重撞擊聲
                const crashOsc = this.ctx.createOscillator();
                const crashGain = this.ctx.createGain();
                crashOsc.type = 'triangle';
                crashOsc.frequency.setValueAtTime(130, now + 0.12);
                crashOsc.frequency.exponentialRampToValueAtTime(28, now + 0.65);
                crashGain.gain.setValueAtTime(0.75, now + 0.12);
                crashGain.gain.exponentialRampToValueAtTime(0.001, now + 0.68);
                crashOsc.connect(crashGain);
                crashGain.connect(this.masterGain);
                crashOsc.start(now + 0.12);
                crashOsc.stop(now + 0.7);
            }

            // 過關成功歡慶旋律（清脆三連音與和弦）
            playVictory() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                // 清脆三連音導入 + 高音勝利和弦
                const notes = [
                    { f: 523.25, t: 0.00, d: 0.14 },
                    { f: 659.25, t: 0.11, d: 0.14 },
                    { f: 783.99, t: 0.22, d: 0.16 },
                    { f: 1046.5, t: 0.36, d: 0.55 },
                    { f: 1318.5, t: 0.36, d: 0.55 }
                ];
                notes.forEach(n => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(n.f, now + n.t);
                    gain.gain.setValueAtTime(0.28, now + n.t);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + n.t + n.d);
                    osc.connect(gain);
                    gain.connect(this.masterGain);
                    osc.start(now + n.t);
                    osc.stop(now + n.t + n.d + 0.03);
                });
            }

            // 防誤觸鎖定期間點擊時的輕微無效「嘟」提示音
            playBlockedBeep() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.linearRampToValueAtTime(175, now + 0.09);
                gain.gain.setValueAtTime(0.18, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                osc.connect(gain);
                gain.connect(this.masterGain);
                osc.start(now);
                osc.stop(now + 0.11);
            }

            // 3 秒保護解除與長按蓄力確認提示音
            playUnlockChime(pitchMultiplier = 1.0) {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33 * pitchMultiplier, now);
                osc.frequency.setValueAtTime(880 * pitchMultiplier, now + 0.08);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.24);
                osc.connect(gain);
                gain.connect(this.masterGain);
                osc.start(now);
                osc.stop(now + 0.25);
            }

            // 全破大結局（第 3 關通關）盛大交響圓滿樂章
            playGrandFinale() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const notes = [
                    { f: 523.25, t: 0.00, d: 0.16, type: 'triangle' }, // C5
                    { f: 659.25, t: 0.14, d: 0.16, type: 'triangle' }, // E5
                    { f: 783.99, t: 0.28, d: 0.16, type: 'triangle' }, // G5
                    { f: 1046.5, t: 0.42, d: 0.25, type: 'triangle' }, // C6
                    { f: 783.99, t: 0.68, d: 0.18, type: 'triangle' }, // G5
                    // 盛大溫暖終章大三和弦
                    { f: 523.25, t: 0.88, d: 1.10, type: 'sine' },     // C5
                    { f: 659.25, t: 0.88, d: 1.10, type: 'triangle' }, // E5
                    { f: 783.99, t: 0.88, d: 1.10, type: 'triangle' }, // G5
                    { f: 1046.5, t: 0.88, d: 1.25, type: 'triangle' }  // C6
                ];
                notes.forEach(n => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = n.type;
                    osc.frequency.setValueAtTime(n.f, now + n.t);
                    gain.gain.setValueAtTime(0.26, now + n.t);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + n.t + n.d);
                    osc.connect(gain);
                    gain.connect(this.masterGain);
                    osc.start(now + n.t);
                    osc.stop(now + n.t + n.d + 0.04);
                });
            }
        }

        const audio = new SpatialAudioEngine();

        /**
         * ============================================================================
         * 4. AI 導盲犬智慧路況分析系統（Gemini API + 即時離線備援演算法）
         * ============================================================================
         */
        async function askAIGuideDog() {
            if (!gameState.isRunning || isRequestingAI) return;
            isRequestingAI = true;
            gameState.aiQueryCount++;
            triggerHaptic([40, 40, 40]);

            const nextLane = gameState.playerLane + 1;
            if (nextLane > gameState.totalLanes) {
                speakText("汪！前方就是終點人行道了，沒有車道，直接跨出最後一步吧！", true, 1.2);
                isRequestingAI = false;
                return;
            }

            // 蒐集各車道即時物理數據
            const laneSummaries = [];
            let immediateDanger = null;
            let safeGapSeconds = 99;

            for (let l = nextLane; l <= gameState.totalLanes; l++) {
                const carsInLane = gameState.vehicles.filter(v => v.lane === l);
                let minTTC = 99;
                let closestCar = null;

                carsInLane.forEach(v => {
                    // 車輛尚未通過玩家中心點 (x = 0)
                    if ((v.dir === 1 && v.x < 0.15) || (v.dir === -1 && v.x > -0.15)) {
                        const dist = Math.abs(v.x);
                        const ttc = dist / v.speed;
                        if (ttc < minTTC) {
                            minTTC = ttc;
                            closestCar = v;
                        }
                    }
                });

                if (l === nextLane) {
                    safeGapSeconds = minTTC;
                    if (closestCar && minTTC < 2.2) {
                        immediateDanger = {
                            dir: closestCar.dir === 1 ? "左邊" : "右邊",
                            name: VEHICLES[closestCar.type].name,
                            ttc: minTTC.toFixed(1)
                        };
                    }
                }

                if (closestCar) {
                    const side = closestCar.dir === 1 ? "左側" : "右側";
                    laneSummaries.push(`第${l}車道：${side}有${VEHICLES[closestCar.type].name}，約${minTTC.toFixed(1)}秒後抵達`);
                } else {
                    laneSummaries.push(`第${l}車道：目前完全淨空無來車`);
                }
            }

            // 1. 立即生成高準確率本地備援提示（確保 0 延遲回應）
            let instantAdvice = "";
            if (immediateDanger) {
                instantAdvice = `汪！別動！前方第${nextLane}車道${immediateDanger.dir}有輛${immediateDanger.name}正快速衝過來，約${immediateDanger.ttc}秒經過，等它過去再走！`;
            } else if (safeGapSeconds < 3.4) {
                instantAdvice = `汪嗚！前方第${nextLane}車道空間有點緊，建議再等兩秒讓這波車流過去會更安全！`;
            } else {
                const gapText = safeGapSeconds > 10 ? "超過5秒大空檔" : `約${Math.floor(safeGapSeconds)}秒空檔`;
                instantAdvice = `汪！前方第${nextLane}車道出現${gapText}，現在安全，快跨出一步！`;
            }

            // 立即先用 TTS 朗讀給玩家聽，避免網路延遲影響過馬路時機
            speakText(instantAdvice, true, 1.22);

            // 2. 非同步呼叫 Gemini API 進行更擬真、具環境感知的 AI 導盲犬語音補充（若網路順暢且玩家仍在原地）
            try {
                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                const prompt = `你是一隻聰明忠心的「AI 導盲犬」，正帶著視障主人過馬路。
目前狀態：
- 關卡：${LEVELS[gameState.level].name}（共 ${gameState.totalLanes} 條車道）
- 主人目前位置：${gameState.playerLane === 0 ? "起點人行道" : "第 " + gameState.playerLane + " 車道"}
- 前方車況：${laneSummaries.join("；")}
- 綠燈剩餘：${Math.ceil(gameState.timeLeft)} 秒

請以導盲犬口吻（「汪！」開頭），用極簡短、急迫或安心的繁體中文口語（35字以內），告訴主人現在該「停下等待」還是「立刻跨出一步」，不要使用任何符號。`;

                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 2200);

                const res = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    signal: controller.signal,
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }]
                    })
                });
                clearTimeout(timeoutId);

                if (res.ok && gameState.isRunning) {
                    const data = await res.json();
                    const geminiReply = data?.candidates?.[0]?.content?.parts?.[0]?.text?.trim();
                    if (geminiReply && geminiReply.length > 5) {
                        document.getElementById('ai-live-text').textContent = `「${geminiReply}」`;
                    }
                }
            } catch (e) {
                // 網路超時或離線時已由本地智慧演算法秒回，完全不影響遊玩
            } finally {
                isRequestingAI = false;
            }
        }

        /**
         * ============================================================================
         * 5. 手機觸控與滑動手勢系統（點擊、上滑前進、下滑後退）
         * ============================================================================
         */
        function setupTouchAndKeyboardControls() {
            const aiZone = document.getElementById('zone-ai-dog');
            const stepZone = document.getElementById('zone-step-forward');

            // 上半部：呼叫 AI 導盲犬
            aiZone.addEventListener('click', (e) => {
                e.preventDefault();
                askAIGuideDog();
            });
            aiZone.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    askAIGuideDog();
                }
            });

            // 下半部：支援點擊前進、向上滑動前進、向下滑動後退
            let touchStartY = 0;
            let touchHandled = false;

            stepZone.addEventListener('touchstart', (e) => {
                if (e.touches.length > 0) {
                    touchStartY = e.touches[0].clientY;
                    touchHandled = false;
                }
            }, { passive: true });

            stepZone.addEventListener('touchend', (e) => {
                if (e.changedTouches.length > 0) {
                    const touchEndY = e.changedTouches[0].clientY;
                    const deltaY = touchStartY - touchEndY; // 正值代表向上滑，負值代表向下滑

                    touchHandled = true;
                    if (deltaY < -45) {
                        // 向下滑動超過 45px：向後退一步閃避
                        stepPlayer(-1);
                    } else {
                        // 點擊或向上滑動：向前跨出一步
                        stepPlayer(1);
                    }
                }
            });

            // 支援電腦滑鼠或螢幕報讀器雙擊觸發
            stepZone.addEventListener('click', (e) => {
                if (touchHandled) {
                    touchHandled = false;
                    return;
                }
                stepPlayer(1);
            });

            stepZone.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    stepPlayer(1);
                }
            });

            // 全域鍵盤支援（方便外接藍牙鍵盤或電腦測試）
            window.addEventListener('keydown', (e) => {
                if (!gameState.isRunning) return;
                if (e.key === 'ArrowUp' || e.key === ' ') {
                    e.preventDefault();
                    stepPlayer(1);
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    stepPlayer(-1);
                } else if (e.key.toLowerCase() === 'h') {
                    e.preventDefault();
                    askAIGuideDog();
                }
            });
        }

        /**
         * ============================================================================
         * 6. 遊戲主循環、碰撞判定與關卡流程
         * ============================================================================
         */
        function initAndStartGame() {
            audio.unlock();
            triggerHaptic([60, 40, 80]);
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('hidden');
            document.getElementById('game-screen').classList.add('flex');
            startLevel(1);
        }

        function startLevel(lvl) {
            audio.unlock();
            // 清除任何殘留的結束鎖定計時器與長按計時器
            if (resultLockTimer) clearInterval(resultLockTimer);
            if (holdInterval) clearInterval(holdInterval);
            gameState.isResultLocked = false;

            gameState.level = lvl;
            const cfg = LEVELS[lvl];

            gameState.isRunning = true;
            gameState.playerLane = 0;
            gameState.totalLanes = cfg.lanes;
            gameState.vehicles = [];
            gameState.timeLeft = cfg.timeLimit;
            gameState.elapsedTime = 0;
            gameState.stepCount = 0;
            gameState.nearMissCount = 0;
            gameState.aiQueryCount = 0;
            gameState.laneTimers = cfg.laneConfigs.map((_, idx) => idx * 0.5 + 0.4);

            audio.clearAll();

            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('hidden');
            document.getElementById('game-screen').classList.add('flex');

            document.getElementById('hud-level').textContent = cfg.name;
            updateLaneHUD();
            resizeCanvas();

            // 預先在遠處生成車輛建立立體音場
            spawnVehicle(1, -1.1);
            if (cfg.lanes >= 3) spawnVehicle(3, 1.15);

            speakText(cfg.intro, true, 1.15);

            lastTime = performance.now();
            if (rafId) cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(loop);
        }

        function handleNextLevel() {
            const next = gameState.level < 3 ? gameState.level + 1 : 1;
            startLevel(next);
        }

        function spawnVehicle(laneNum, presetX = null) {
            const cfg = LEVELS[gameState.level];
            const laneCfg = cfg.laneConfigs[laneNum - 1];
            if (!laneCfg) return;

            const type = laneCfg.types[Math.floor(Math.random() * laneCfg.types.length)];
            let speedFactor = 1.0;
            if (type === 'scooter') speedFactor = 1.22;
            if (type === 'bus') speedFactor = 0.84;
            if (type === 'ambulance') speedFactor = 1.35;

            const vehicle = {
                id: Date.now() + Math.random(),
                lane: laneNum,
                dir: laneCfg.dir,
                type: type,
                speed: laneCfg.speed * speedFactor,
                x: presetX !== null ? presetX : (laneCfg.dir === 1 ? -1.45 : 1.45),
                warnedNearMiss: false
            };

            gameState.vehicles.push(vehicle);
            audio.createVehicleSound(vehicle);
        }

        function stepPlayer(delta) {
            if (!gameState.isRunning) return;

            const target = gameState.playerLane + delta;
            if (target < 0) {
                triggerHaptic(50);
                speakText("已經在起點人行道了，無法再後退。", true, 1.2);
                return;
            }

            gameState.playerLane = target;
            gameState.stepCount++;
            audio.playStepAndCane(delta > 0);
            triggerHaptic(delta > 0 ? 45 : [30, 30, 30]);
            updateLaneHUD();

            // 抵達對岸終點
            if (gameState.playerLane > gameState.totalLanes) {
                finishGame(true, "成功穿越所有車道抵達對岸");
                return;
            }

            const stepsLeft = gameState.totalLanes - gameState.playerLane + 1;
            if (gameState.playerLane === 0) {
                speakText("退回起點人行道。", true, 1.25);
            } else {
                speakText(`第${gameState.playerLane}車道，還剩${stepsLeft}步。`, true, 1.3);
            }
        }

        function updateLaneHUD() {
            const el = document.getElementById('hud-lane');
            if (gameState.playerLane === 0) {
                el.textContent = "起點人行道";
                el.className = "text-yellow-400";
            } else if (gameState.playerLane > gameState.totalLanes) {
                el.textContent = "抵達終點！";
                el.className = "text-emerald-400";
            } else {
                el.textContent = `第 ${gameState.playerLane} / ${gameState.totalLanes} 車道`;
                el.className = "text-amber-400";
            }
        }

        function loop(now) {
            if (!gameState.isRunning) return;

            const dt = Math.min(0.1, (now - lastTime) / 1000);
            lastTime = now;

            gameState.elapsedTime += dt;
            gameState.timeLeft -= dt;

            // 更新倒數計時與台灣有聲紅綠燈布穀鳥節奏
            const secs = Math.max(0, Math.ceil(gameState.timeLeft));
            const timerEl = document.getElementById('hud-timer');
            timerEl.textContent = secs;
            timerEl.className = secs <= 10 ? "text-red-500 animate-pulse" : "text-emerald-400";

            signalBeepTimer += dt;
            const interval = secs <= 10 ? 0.52 : 1.5;
            if (signalBeepTimer >= interval) {
                signalBeepTimer = 0;
                audio.playCrosswalkSignal(secs <= 10);
            }

            if (gameState.timeLeft <= 0) {
                finishGame(false, "行人綠燈號誌已轉紅燈，滯留於馬路中央");
                return;
            }

            // 生成新車輛
            const cfg = LEVELS[gameState.level];
            for (let i = 0; i < cfg.lanes; i++) {
                gameState.laneTimers[i] -= dt;
                if (gameState.laneTimers[i] <= 0) {
                    spawnVehicle(i + 1);
                    gameState.laneTimers[i] = cfg.spawnMin + Math.random() * (cfg.spawnMax - cfg.spawnMin);
                }
            }

            // 更新車輛物理與 3D 音效
            for (let i = gameState.vehicles.length - 1; i >= 0; i--) {
                const v = gameState.vehicles[i];
                v.x += v.dir * v.speed * dt;
                audio.updateVehicleSound(v, gameState.playerLane, dt);

                const spec = VEHICLES[v.type];
                const distX = Math.abs(v.x);

                if (v.lane === gameState.playerLane) {
                    if (distX < spec.width * 0.72) {
                        // 發生碰撞
                        finishGame(false, `被第${v.lane}車道的${spec.name}擦撞`);
                        return;
                    } else if (distX < spec.width * 1.65 && !v.warnedNearMiss) {
                        // 車輛逼近驚險擦身警告
                        v.warnedNearMiss = true;
                        gameState.nearMissCount++;
                        audio.playEmergencyHorn(v.x);
                        triggerHaptic([120, 50, 120]);
                        triggerShake();
                    }
                }

                if (v.x > 1.65 || v.x < -1.65) {
                    audio.removeVehicleSound(v.id);
                    gameState.vehicles.splice(i, 1);
                }
            }

            renderVisionCanvas();
            rafId = requestAnimationFrame(loop);
        }

