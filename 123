                btn.setAttribute('aria-label', '切換視覺模擬模式，目前為重度弱視極度模糊光影模式');
                // 降低按鈕背景不透明度，讓底層極度模糊的車燈光暈透出來
                aiZone.classList.replace('bg-blue-950/85', 'bg-blue-950/35');
                stepZone.classList.replace('bg-yellow-400/95', 'bg-yellow-400/35');
                stepZone.classList.replace('text-black', 'text-yellow-300');
                speakText("切換至重度弱視模式，螢幕將呈現極度模糊的車燈光影移動。", true, 1.2);
            } else {
                gameState.visionMode = 'blind';
                btn.textContent = "👁️ 全盲黑屏模式";
                btn.setAttribute('aria-label', '切換視覺模擬模式，目前為全黑盲人模式');
                aiZone.classList.replace('bg-blue-950/35', 'bg-blue-950/85');
                stepZone.classList.replace('bg-yellow-400/35', 'bg-yellow-400/95');
                stepZone.classList.replace('text-yellow-300', 'text-black');
                speakText("切換至全盲黑屏模式，請完全依賴雙耳聽覺。", true, 1.2);
            }
            triggerHaptic(35);
        }

        function resizeCanvas() {
            const canvas = document.getElementById('vision-canvas');
            if (!canvas) return;
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);

        function renderVisionCanvas() {
            const canvas = document.getElementById('vision-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            ctx.fillStyle = '#000000';
            ctx.fillRect(0, 0, w, h);

            if (gameState.visionMode !== 'lowvision') return;

            // 重度弱視模式：極度模糊的刺眼車燈與對岸綠燈光暈
            ctx.save();
            ctx.filter = 'blur(32px)';

            // 遠端對岸綠燈微光
            const gGrad = ctx.createRadialGradient(w / 2, 70, 5, w / 2, 70, 90);
            gGrad.addColorStop(0, 'rgba(0, 230, 118, 0.7)');
            gGrad.addColorStop(1, 'rgba(0, 230, 118, 0)');
            ctx.fillStyle = gGrad;
            ctx.fillRect(w / 2 - 100, 0, 200, 160);

            // 車輛模糊光團
            const totalRows = gameState.totalLanes + 2;
            const rowH = (h - 60) / totalRows;

            gameState.vehicles.forEach(v => {
                const sx = ((v.x + 1.2) / 2.4) * w;
                const rowIdx = totalRows - 1 - v.lane;
                const sy = 60 + (rowIdx + 0.5) * rowH;
                const radius = v.type === 'bus' ? 85 : v.type === 'scooter' ? 45 : 65;

                const grad = ctx.createRadialGradient(sx, sy, 5, sx, sy, radius);
                grad.addColorStop(0, 'rgba(255, 250, 200, 1)');
                grad.addColorStop(0.5, v.type === 'ambulance' ? 'rgba(255, 23, 68, 0.85)' : 'rgba(255, 175, 0, 0.7)');
                grad.addColorStop(1, 'rgba(0, 0, 0, 0)');

                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(sx, sy, radius, 0, Math.PI * 2);
                ctx.fill();
            });

            ctx.restore();
        }

        // 初始化綁定觸控與手勢事件
        window.addEventListener('DOMContentLoaded', () => {
            setupTouchAndKeyboardControls();
            setupResultHoldButtons();
            resizeCanvas();
        });
    </script>
</body>
</html>
